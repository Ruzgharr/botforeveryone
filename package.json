{
  "name": "public-bot-ecosystem",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "node index.js",
    "dashboard": "node apps/dashboard/src/index.js",
    "dashboard:v2": "node apps/dashboard-v2/src/index.js",
    "moderation": "node apps/moderation/src/index.js",
    "register": "node apps/register/src/index.js",
    "stats": "node apps/stats/src/index.js",
    "guard": "node apps/guard-main/src/index.js",
    "distributor": "node apps/guard-distributor/src/index.js",
    "voice": "node apps/voice-welcome/src/index.js",
    "economy": "node apps/economy/src/index.js",
    "utility": "node apps/utility/src/index.js",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-source.mjs",
    "test:gateway": "node scripts/check-gateways.mjs",
    "test:live": "node scripts/live-smoke.mjs",
    "test:database": "node scripts/test-database.mjs",
    "bots": "node scripts/run-bots.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "cors": "^2.8.5",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.12.1",
    "msedge-tts": "^2.0.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0"
  }
}
